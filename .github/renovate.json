{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "timezone": "America/Vancouver",
  "dependencyDashboard": true,
  "semanticCommits": "enabled",
  "assignees": [
    "@ivanjosipovic"
  ],
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "ignorePaths": [
    "**/docs/**"
  ],
  "packageRules": [
    {
      "groupName": "KubernetesCRDModelGen",
      "separateMajorMinor": true,
      "groupSlug": "kube-crd-model-gen",
      "matchPackageNames": [
        "/KubernetesCRDModelGen/",
        "/KubernetesCRDModelGen.*/"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "matchFileNames": [
        "tests/**",
        "benchmarks/**",
        "global.json"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "semanticCommitType": "fix",
      "matchFileNames": [
        "src/**"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "semanticCommitType": "fix",
      "matchFileNames": [
        "src/**"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "semanticCommitType": "chore",
      "matchFileNames": [
        "src/Function.SDK.CSharp.Sample/**"
      ]
    }
  ]
}
